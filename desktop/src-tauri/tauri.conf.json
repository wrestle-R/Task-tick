{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task-tick",
  "version": "0.2.2",
  "identifier": "com.tickanddone.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Task-tick",
        "width": 1180,
        "height": 790,
        "minWidth": 700,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: data: https://image.tmdb.org; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "shortDescription": "Your todos and watchlist, within reach",
    "category": "Productivity",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNUIyM0I3NTlFQjJGMjUKUldRbEwrdFp0eU5iLytMeWJ3Z2NKSk1NZ0Fsd1EzWXNyR01vUW5FVmFBNGlKNzhveG5RT1Bxc2oK",
      "endpoints": [
        "https://task-tick-beige.vercel.app/api/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
